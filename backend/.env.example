# Nexus Agent Hub — Backend env (copy to .env)
# API tokens — set for each limb you enable

# Phase 2 — Orchestration (LangGraph) - LLM Providers
# --- Google Gemini (choose one) ---
# Option A: Use GCP project billing / $300 credits (RECOMMENDED if you have GCP free trial)
#   - Enable "Generative Language API" in the project: console.cloud.google.com → APIs & Services
#   - Set GOOGLE_CLOUD_PROJECT to your project ID (same project that has billing/credits)
#   - Auth: run once: gcloud auth application-default login
#   - Leave GOOGLE_API_KEY unset when using this option
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Option B: AI Studio free-tier key (subject to free-tier limits; does NOT use GCP credits)
#   - Get key at https://aistudio.google.com/apikey
#   - When free tier is exhausted you get 429 / limit: 0
# GOOGLE_API_KEY=AIza...

# Option C: Groq (fast inference, free tier)
# GROQ_API_KEY=gsk_...

# Notion (Phase 1.2 — first limb). Get from https://www.notion.so/profile/integrations
# Create internal integration, copy "Internal Integration Secret" (starts with ntn_)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SLACK_BOT_TOKEN=
# GITHUB_TOKEN=
# MONGODB_URI=
# STRIPE_SECRET_KEY=

# ============================================================================
# Supabase (User Authentication & Database)
# Get from https://supabase.com → Project Settings → API
# ============================================================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key for admin operations (backend only; required for chat history, connections)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Encryption key for storing API credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# CREDENTIALS_ENCRYPTION_KEY=your-fernet-key-here

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins; default allows local dev)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Rate limit (requests per minute per IP/user; 0 = disabled)
# RATE_LIMIT_PER_MINUTE=60

