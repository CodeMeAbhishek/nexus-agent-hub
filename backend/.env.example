# Nexus Agent Hub — Backend env (copy to .env)
# API tokens — set for each limb you enable

# Phase 2 — Orchestration (LangGraph) - LLM Providers
# Option 1: Google Gemini (RECOMMENDED - 1M token context, free tier)
# Get API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Option 2: Groq (fast inference, free tier)
# Get API key at https://console.groq.com
GROQ_API_KEY=gsk_...

# Notion (Phase 1.2 — first limb). Get from https://www.notion.so/profile/integrations
# Create internal integration, copy "Internal Integration Secret" (starts with ntn_)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SLACK_BOT_TOKEN=
# GITHUB_TOKEN=
# MONGODB_URI=
# STRIPE_SECRET_KEY=

# ============================================================================
# Supabase (User Authentication & Database)
# Get from https://supabase.com → Project Settings → API
# ============================================================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service key for admin operations (optional, backend only)
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Encryption key for storing API credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# CREDENTIALS_ENCRYPTION_KEY=your-fernet-key-here

# Server
HOST=0.0.0.0
PORT=8000

